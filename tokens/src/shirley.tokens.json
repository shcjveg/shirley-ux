  "themed": {
    "--vx-shadow-card": {
      "light": "0 1px 2px rgba(16, 20, 24, 0.04), 0 2px 8px -4px rgba(16, 20, 24, 0.06)",
      "dark": "0 1px 2px rgba(0, 0, 0, 0.4)"
    },
    "--vx-shadow-overlay": {
      "light": "0 8px 24px -12px rgba(16, 20, 24, 0.18), 0 32px 64px -32px rgba(16, 20, 24, 0.24)",
